# Configuração da suíte de testes.
#
# Fonte única de verdade do ambiente de teste — carregada por
# tests/bootstrap.php direto no $_SERVER. Ver o comentário lá para entender
# por que o bloco <env> do phpunit.xml não dá conta sozinho dentro do Docker.
#
# Não contém segredo real: são credenciais do Postgres local do
# docker-compose. Nunca colocar chave de produção aqui.

APP_ENV=testing
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

BROADCAST_CONNECTION=null
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array

# SQLite não suporta jsonb/tipos nativos do Postgres usados nas migrations —
# a suíte roda contra um banco Postgres real e separado, nunca o de dev.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexo_crm_testing
DB_USERNAME=nexo_crm
DB_PASSWORD=secret
DB_URL=

REDIS_CLIENT=predis
REDIS_HOST=redis

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
